{
  "name": "design-app-design-system",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "prepare": "panda codegen",
    "watch": "panda codegen --watch",
    "new": "panda init",
    "panda": "panda",
    "emit-pkg": "panda emit-pkg"
  },
  "keywords": [],
  "author": "whoisryosuke",
  "license": "MIT",
  "devDependencies": {
    "@pandacss/dev": "^2.4.0",
    "@types/react": "^19.2.7",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "exports": {
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.js"
    },
    "./css/*": {
      "types": "./dist/css/*.d.ts",
      "default": "./dist/css/*.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./dist/recipes/*.d.ts",
      "default": "./dist/recipes/*.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "default": "./dist/patterns/*.js"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.ts",
      "default": "./dist/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./dist/jsx/*.d.ts",
      "default": "./dist/jsx/*.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  }
}
